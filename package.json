{
  "name": "websitegift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "mail:retry": "node --env-file-if-exists=.env.local --import tsx scripts/retry-mail.ts",
    "maintenance": "node --env-file-if-exists=.env.local --import tsx scripts/maintenance.ts",
    "seed:local": "node --env-file-if-exists=.env.local --import tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  }
}
